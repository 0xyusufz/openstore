{
  "name": "openstore",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source decentralized encrypted storage network",
  "type": "module",
  "scripts": {
    "dev": "tsx",
    "openstore": "tsx apps/client/cli.ts",
    "web": "npm run build && node dist/apps/web/server.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decentralized-storage",
    "p2p",
    "encryption",
    "distributed-storage"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@libp2p/mplex": "^12.0.32",
    "@libp2p/tcp": "^11.0.28",
    "@multiformats/multiaddr": "^13.0.3",
    "libp2p": "^3.3.11"
  }
}
